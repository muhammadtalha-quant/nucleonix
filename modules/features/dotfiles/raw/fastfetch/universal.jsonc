{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "nixos",
    "padding": {
      "left": 3,
    }
  },
  "display": {
    "separator": " \u001b[38;2;136;57;239m\u001b[0m ",
    "constants": [
      "\u001b[38;2;221;120;120m─────────────────\u001b[0m" // {$1}, used in Custom module
    ],
    "key": {
      "type": "icon",
      "paddingLeft": 2
    }
  },
  "modules": [
    {
      "type": "custom", // HardwareStart
      // {#1} is equivalent to `\u001b[1m`. {#} is equivalent to `\u001b[m`
      "format": "\u001b[38;2;221;120;120m┌\u001b[0m{$1} \u001b[38;2;136;57;239mHardware Information\u001b[0m {$1}\u001b[38;2;221;120;120m┐\u001b[0m"
    },
    {
      "type": "host"
    },
    {
      "type": "cpu"
    },
    {
      "type": "gpu"
    },
    {
      "type": "disk"
    },
    {
      "type": "memory"
    },
    {
      "type": "display"
    },
    {
      "type": "custom", // InformationEnd
      "format": "\u001b[38;2;221;120;120m└\u001b[0m{$1}\u001b[38;2;221;120;120m──────────────────────\u001b[0m{$1}\u001b[38;2;221;120;120m┘\u001b[0m"
    },
    {
      "type": "custom", // Separator
      "format": ""
    },
    {
      "type": "custom", // SoftwareStart
      "format": "\u001b[38;2;221;120;120m┌\u001b[0m{$1} \u001b[38;2;136;57;239mSoftware Information\u001b[0m {$1}\u001b[38;2;221;120;120m┐\u001b[0m"
    },
    {
      "type": "os"
    },
    {
      "type": "kernel"
    },
    {
      "type": "lm"
    },
    {
      "type": "de"
    },
    {
      "type": "wm"
    },
    {
      "type": "shell"
    },
    {
      "type": "terminal"
    },
    {
      "type": "font"
    },
    {
      "type": "theme"
    },
    {
      "type": "icons"
    },
    {
      "type": "packages"
    },
    {
      "type": "uptime"
    },
    {
      "type": "disk",
      "folders": "/",
      "format": "{create-time:10} ({days} days)"
    },
    {
      "type": "custom", // InformationEnd
      "format": "\u001b[38;2;221;120;120m└\u001b[0m{$1}\u001b[38;2;221;120;120m──────────────────────\u001b[0m{$1}\u001b[38;2;221;120;120m┘\u001b[0m"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 21
    }
  ]
}
